# ====================================
# DukeFarm Backend - Environment Configuration
# ====================================
# Copy this file to .env and update with your actual values

# ----------------
# Database
# ----------------
# PostgreSQL connection string for Prisma ORM
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Local: postgresql://postgres:postgres@localhost:5432/dukefarm?schema=public
# Production: Use connection string from hosting provider (Render, AWS RDS, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dukefarm?schema=public"

# ----------------
# JWT Authentication
# ----------------
# Secret key for signing and verifying JWT tokens
# IMPORTANT: Generate a secure random secret in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secure-random-secret-key-minimum-32-characters"

# ----------------
# LINE Login OAuth
# ----------------
# Get these credentials from LINE Developers Console: https://developers.line.biz/console/
# 1. Create a new channel (LINE Login)
# 2. Copy Channel ID and Channel Secret
# 3. Set Callback URL in LINE Console to match LINE_REDIRECT_URI below

# LINE Login Channel ID (numeric)
LINE_CHANNEL_ID="1234567890"

# LINE Login Channel Secret (alphanumeric)
LINE_CHANNEL_SECRET="your-line-channel-secret-here"

# OAuth callback URL (must match LINE Console exactly)
# Development: http://localhost:4000/api/auth/line/callback
# Production: https://your-domain.com/api/auth/line/callback
# With ngrok: https://abc123.ngrok-free.app/api/auth/line/callback
LINE_REDIRECT_URI="http://localhost:4000/api/auth/line/callback"

# ----------------
# Frontend Integration
# ----------------
# Frontend URL where users are redirected after LINE login completes
# The backend appends query parameters: ?token=xxx&user=xxx&role=xxx&registrationStatus=xxx
# Development: http://localhost:3000/auth/callback
# Production: https://your-frontend-domain.com/auth/callback
FRONTEND_CALLBACK_URL="http://localhost:3000/auth/callback"

# ----------------
# Server Configuration
# ----------------
# HTTP server port (optional, defaults to 4000)
PORT=4000

# Node environment: development, test, production
NODE_ENV="development"

# ----------------
# External APIs
# ----------------
# Weather data: Google Weather API (https://developers.google.com/maps/documentation/weather)
# Requires enabling the Weather API in Google Cloud console and generating an API key
# Billing must be enabled. Monitor usage to stay within your quota.
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ----------------
# Production Checklist
# ----------------
# Before deploying to production:
# [ ] Use managed PostgreSQL database (Render, AWS RDS, DigitalOcean)
# [ ] Generate strong JWT_SECRET with crypto.randomBytes(32)
# [ ] Use HTTPS URLs for LINE_REDIRECT_URI and FRONTEND_CALLBACK_URL
# [ ] Set NODE_ENV=production
# [ ] Store secrets in hosting provider's environment variables (not .env file)
# [ ] Update LINE Console with production callback URL
# [ ] Run database migrations: npx prisma migrate deploy
# [ ] Test all endpoints with production credentials
