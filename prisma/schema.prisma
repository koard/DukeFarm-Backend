generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  UNASSIGNED
  FARMER
  RESEARCHER
  ADMIN
}

enum RegistrationStatus {
  PENDING
  COMPLETED
}

enum FarmType {
  SMALL    // Pla Tum nurseries (7-10 days, formerly Fingerling)
  LARGE    // Pla Nio juvenile stage (11-30 days, formerly Fattening)
  MARKET   // Pla Talad grow-out (31-180 days / ~2-6 months)
}

enum PondType {
  EARTHEN
  CONCRETE
}

enum HarvestReadinessStatus {
  UNKNOWN
  TOO_EARLY
  OPTIMAL
  LATE
}

enum DiseaseCaseStatus {
  ACTIVE
  RESOLVED
}

enum DiseaseSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum FoodType {
  FRESH      // อาหารสด
  PELLET     // อาหารเม็ด
  SUPPLEMENT // วิตามิน/โปรไบโอติก
}

enum ProductionCycleStatus {
  PLANNING
  STOCKING
  GROWOUT
  HARVEST_READY
  HARVESTED
  ABORTED
}

enum LoginProvider {
  LOCAL
  LINE
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  passwordHash       String             @map("password_hash")
  lineUserId         String?            @unique @map("line_user_id")
  displayName        String?            @map("display_name")
  pictureUrl         String?            @map("picture_url")
  loginProvider      LoginProvider      @default(LINE) @map("login_provider")
  role               UserRole           @default(UNASSIGNED)
  registrationStatus RegistrationStatus @default(PENDING) @map("registration_status")
  farms              Farm[]
  feedFormulas       FeedFormula[]
  farmerProfile      FarmerProfile?
  researcherProfile  ResearcherProfile?
  farmDataEntries    FarmDataEntry[]
  cultivationTypes   FarmerCultivationType[]
  diseaseCases       DiseaseCase[]
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}

model Farm {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  owner        User     @relation(fields: [ownerId], references: [id])
  name         String
  farmType     FarmType @map("farm_type")
  address      String?
  province     String?
  latitude     Float?
  longitude    Float?
  areaM2       Decimal? @map("area_m2") @db.Decimal(10, 2)

  feedFormulas FeedFormula[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("farms")
}



model ProductionCycle {
  id                  String                 @id @default(uuid()) @db.Uuid

  startDate           DateTime               @map("start_date")
  endDate             DateTime?              @map("end_date")
  status              ProductionCycleStatus  @default(PLANNING)
  initialStockCount   Int?                   @map("initial_stock_count")
  initialAvgWeightKg  Decimal?               @map("initial_avg_weight_kg") @db.Decimal(8, 3)
  targetHarvestDate   DateTime?              @map("target_harvest_date")
  notes               String?
  farmType            FarmType?              @map("farm_type")
  pondId              String?                @map("pond_id") @db.Uuid
  pond                Pond?                  @relation(fields: [pondId], references: [id])
  farmDataEntries     FarmDataEntry[]
  dailyRecords        DailyRecord[]
  researchSurveys     ResearchSurvey[]
  diseaseCases        DiseaseCase[]
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @default(now()) @updatedAt @map("updated_at")


  @@index([status])
  @@index([pondId])
  @@map("production_cycles")
}

model DailyRecord {
  id                 String            @id @default(uuid()) @db.Uuid
  productionCycleId  String            @map("production_cycle_id") @db.Uuid
  productionCycle    ProductionCycle   @relation(fields: [productionCycleId], references: [id])
  recordDate         DateTime          @map("record_date")
  waterTemperatureC  Float?            @map("water_temperature_c")
  dissolvedOxygenMgL Float?            @map("dissolved_oxygen_mg_l")
  ph                 Float?
  ammoniaMgL         Float?            @map("ammonia_mg_l")
  nitriteMgL         Float?            @map("nitrite_mg_l")
  weatherSummary     String?           @map("weather_summary")
  feedingBehavior    String?           @map("feeding_behavior")
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([productionCycleId, recordDate])
  @@map("daily_records")
}

model FeedFormula {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  foodType        FoodType  @default(FRESH) @map("food_type")
  nutrients       String?   @map("nutrients")
  usage           String?   @map("usage")
  recommendations String?
  targetStage     String?   @map("target_stage")
  farmType        FarmType? @map("farm_type")
  farmId          String?   @map("farm_id") @db.Uuid
  ownerId         String?   @map("owner_id") @db.Uuid
  farm            Farm?     @relation(fields: [farmId], references: [id])
  owner           User?     @relation(fields: [ownerId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("feed_formulas")
}



model ResearchSurvey {
  id                  String          @id @default(uuid()) @db.Uuid
  productionCycleId   String          @map("production_cycle_id") @db.Uuid
  productionCycle     ProductionCycle @relation(fields: [productionCycleId], references: [id])
  surveyDate          DateTime        @map("survey_date")
  surveyType          String          @map("survey_type")
  conductedBy         String?         @map("conducted_by")
  partnerOrganization String?         @map("partner_organization")
  dataPayload         Json?           @map("data_payload")
  notes               String?
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([productionCycleId, surveyDate])
  @@map("research_surveys")
}

model FarmerProfile {
  userId            String        @id @map("user_id") @db.Uuid
  user              User          @relation(fields: [userId], references: [id])
  firstName         String        @map("first_name")
  lastName          String        @map("last_name")
  phone             String        @map("phone")
  primaryFarmType   FarmType      @map("primary_farm_type")
  declaredPondCount Int?          @map("declared_pond_count") // Total number of ponds (can be just a number)
  recordedPondCount Int?          @map("recorded_pond_count") // Number of ponds user wants to record data for
  farmLatitude      Float?        @map("farm_latitude")
  farmLongitude     Float?        @map("farm_longitude")
  farmAreaRai       Decimal?      @map("farm_area_rai") @db.Decimal(10, 2)
  pondsPerRai       Decimal?      @map("ponds_per_rai") @db.Decimal(10, 2)
  ponds             Pond[]
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at")

  @@map("farmer_profiles")
}

model Pond {
  id              String          @id @default(uuid()) @db.Uuid
  profileId       String          @map("profile_id") @db.Uuid
  profile         FarmerProfile   @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  pondType        PondType        @map("pond_type")
  farmType        FarmType        @default(SMALL) @map("farm_type")
  widthM          Decimal         @map("width_m") @db.Decimal(10, 2)
  lengthM         Decimal         @map("length_m") @db.Decimal(10, 2)
  depthM          Decimal         @map("depth_m") @db.Decimal(10, 2)
  volumeM3        Decimal         @map("volume_m3") @db.Decimal(12, 2)
  farmDataEntries FarmDataEntry[]
  productionCycles ProductionCycle[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("ponds")
}

model FarmerCultivationType {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  user              User             @relation(fields: [userId], references: [id])
  farmType          FarmType         @map("farm_type")
  cultivatedAreaRai Decimal?         @map("cultivated_area_rai") @db.Decimal(10, 2)
  pondsInStage      Int?             @map("ponds_in_stage")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at")
  farmDataEntries   FarmDataEntry[]
  diseaseCases      DiseaseCase[]

  @@unique([userId, farmType], name: "farmer_cultivation_type_user_stage_unique")
  @@index([userId])
  @@map("farmer_cultivation_types")
}

model FishAgeStage {
  id                     String           @id @default(uuid()) @db.Uuid
  farmType               FarmType         @map("farm_type")
  code                   String
  displayName            String           @map("display_name")
  minDay                 Int              @map("min_day")
  maxDay                 Int?             @map("max_day")
  harvestStartDay        Int?             @map("harvest_start_day")
  harvestEndDay          Int?             @map("harvest_end_day")
  description            String?
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at")
  farmDataEntries        FarmDataEntry[]
  diseaseCases           DiseaseCase[]

  @@unique([farmType, code], name: "fish_age_stage_farmType_code_unique")
  @@map("fish_age_stages")
}

model ResearcherProfile {
  userId       String   @id @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @map("email")
  phone        String   @map("phone")
  organization String   @map("organization")
  department   String?  @map("department")
  jobTitle     String?  @map("job_title")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("researcher_profiles")
}

model FarmDataEntry {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  user               User      @relation(fields: [userId], references: [id])
  farmType           FarmType  @map("farm_type")
  cultivationTypeId  String?   @map("cultivation_type_id") @db.Uuid
  cultivationType    FarmerCultivationType? @relation(fields: [cultivationTypeId], references: [id])
  pondId             String?   @map("pond_id") @db.Uuid
  pond               Pond?     @relation(fields: [pondId], references: [id])
  productionCycleId  String?   @map("production_cycle_id") @db.Uuid
  productionCycle    ProductionCycle? @relation(fields: [productionCycleId], references: [id])
  recordedAt         DateTime  @map("recorded_at")
  fishAgeLabel       String    @map("fish_age_label")
  fishAgeDays        Int?      @map("fish_age_days")
  fishAgeStageId     String?   @map("fish_age_stage_id") @db.Uuid
  fishAgeStage       FishAgeStage? @relation(fields: [fishAgeStageId], references: [id])
  harvestStatus      HarvestReadinessStatus? @map("harvest_status")
  harvestStatusReason String?  @map("harvest_status_reason")
  pondType           PondType? @map("pond_type")
  pondCount          Int?      @map("pond_count")
  fishReleased       Int?      @map("fish_released")
  fishRemaining      Int?      @map("fish_remaining")
  averageFishWeightGr Decimal? @map("average_fish_weight_gr") @db.Decimal(10, 2)
  foodAmountKg       Float?    @map("food_amount_kg")
  feedFormulaName    String?   @map("feed_formula_name")
  supplementName     String?   @map("supplement_name")
  medicineName       String?   @map("medicine_name")
  foodCostBaht       Float?    @map("food_cost_baht")
  medicineCostBaht   Float?    @map("medicine_cost_baht")
  weatherTemperatureC Float?   @map("weather_temperature_c")
  weatherRainMm      Float?   @map("weather_rain_mm")
  weatherHumidityPct Float?   @map("weather_humidity_pct")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([userId, recordedAt])
  @@index([cultivationTypeId])
  @@index([fishAgeStageId])
  @@index([pondId])
  @@map("farm_data_entries")
}

model DiseaseCase {
  id                 String                  @id @default(uuid()) @db.Uuid
  userId             String                  @map("user_id") @db.Uuid
  user               User                    @relation(fields: [userId], references: [id])
  productionCycleId  String?                 @map("production_cycle_id") @db.Uuid
  productionCycle    ProductionCycle?        @relation(fields: [productionCycleId], references: [id])
  cultivationTypeId  String?                 @map("cultivation_type_id") @db.Uuid
  cultivationType    FarmerCultivationType?  @relation(fields: [cultivationTypeId], references: [id])
  farmType           FarmType?               @map("farm_type")
  fishAgeStageId     String?                 @map("fish_age_stage_id") @db.Uuid
  fishAgeStage       FishAgeStage?           @relation(fields: [fishAgeStageId], references: [id])
  reportedAt         DateTime                @map("reported_at")
  diseaseName        String                  @map("disease_name")
  symptoms           String?
  severity           DiseaseSeverity         @default(MODERATE)
  status             DiseaseCaseStatus       @default(ACTIVE)
  notes              String?
  photos             DiseasePhoto[]
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at")

  @@index([userId, reportedAt])
  @@index([productionCycleId])
  @@index([cultivationTypeId])
  @@map("disease_cases")
}

model DiseasePhoto {
  id            String       @id @default(uuid()) @db.Uuid
  diseaseCaseId String       @map("disease_case_id") @db.Uuid
  diseaseCase   DiseaseCase  @relation(fields: [diseaseCaseId], references: [id])
  photoUrl      String       @map("photo_url")
  caption       String?
  capturedAt    DateTime?    @map("captured_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")

  @@index([diseaseCaseId])
  @@map("disease_photos")
}

model Disease {
  id               String            @id @default(cuid())
  name             String            @unique
  category         String
  symptoms         String
  causes           String?
  treatment        String?
  prevention       String?
  icon             String?
  treatmentSummary String?
  tags             DiseaseSymptom[]
  matches          DiseaseMatch[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
}

model DiseaseSymptom {
  id        String   @id @default(cuid())
  label     String
  disease   Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  diseaseId String
}

model UploadedFile {
  id        String   @id @default(cuid())
  filePath  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())
  analysisRequests DiseaseAnalysisRequest[]
}

model DiseaseAnalysisRequest {
  id          String          @id @default(cuid())
  symptomText String
  symptomTags String[]
  photoId     String?
  photo       UploadedFile?   @relation(fields: [photoId], references: [id])
  createdAt   DateTime        @default(now())
  matches     DiseaseMatch[]
}

model DiseaseMatch {
  id         String                   @id @default(cuid())
  request    DiseaseAnalysisRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  String
  disease    Disease                  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  diseaseId  String
  score      Float
  rank       Int
  createdAt  DateTime                 @default(now())
}


