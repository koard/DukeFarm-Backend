generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  UNASSIGNED
  FARMER
  RESEARCHER
  ADMIN
}

enum RegistrationStatus {
  PENDING
  COMPLETED
}

enum FarmType {
  NURSERY_SMALL
  NURSERY_LARGE
  GROWOUT
}

enum PondType {
  EARTHEN
  CONCRETE
}

enum ProductionCycleStatus {
  PLANNING
  STOCKING
  GROWOUT
  HARVEST_READY
  HARVESTED
  ABORTED
}

enum LoginProvider {
  LOCAL
  LINE
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  passwordHash       String             @map("password_hash")
  lineUserId         String?            @unique @map("line_user_id")
  displayName        String?            @map("display_name")
  pictureUrl         String?            @map("picture_url")
  loginProvider      LoginProvider      @default(LINE) @map("login_provider")
  role               UserRole           @default(UNASSIGNED)
  registrationStatus RegistrationStatus @default(PENDING) @map("registration_status")
  farms              Farm[]
  feedFormulas       FeedFormula[]
  farmerProfile      FarmerProfile?
  researcherProfile  ResearcherProfile?
  farmDataEntries    FarmDataEntry[]
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}

model Farm {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  owner        User     @relation(fields: [ownerId], references: [id])
  name         String
  farmType     FarmType @map("farm_type")
  address      String?
  province     String?
  latitude     Float?
  longitude    Float?
  areaM2       Decimal? @map("area_m2") @db.Decimal(10, 2)
  ponds        Pond[]
  feedFormulas FeedFormula[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("farms")
}

model Pond {
  id               String             @id @default(uuid()) @db.Uuid
  farmId           String             @map("farm_id") @db.Uuid
  farm             Farm               @relation(fields: [farmId], references: [id])
  name             String
  pondType         PondType           @map("pond_type")
  areaM2           Decimal?           @map("area_m2") @db.Decimal(10, 2)
  maxDepthM        Decimal?           @map("max_depth_m") @db.Decimal(10, 2)
  notes            String?
  productionCycles ProductionCycle[]
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([farmId])
  @@map("ponds")
}

model ProductionCycle {
  id                  String                 @id @default(uuid()) @db.Uuid
  pondId              String                 @map("pond_id") @db.Uuid
  pond                Pond                   @relation(fields: [pondId], references: [id])
  startDate           DateTime               @map("start_date")
  endDate             DateTime?              @map("end_date")
  status              ProductionCycleStatus  @default(PLANNING)
  initialStockCount   Int?                   @map("initial_stock_count")
  initialAvgWeightKg  Decimal?               @map("initial_avg_weight_kg") @db.Decimal(8, 3)
  targetHarvestDate   DateTime?              @map("target_harvest_date")
  notes               String?
  dailyRecords        DailyRecord[]
  feedings            Feeding[]
  growthMeasurements  GrowthMeasurement[]
  mortalities         Mortality[]
  treatments          Treatment[]
  researchSurveys     ResearchSurvey[]
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @default(now()) @updatedAt @map("updated_at")

  @@index([pondId])
  @@index([status])
  @@map("production_cycles")
}

model DailyRecord {
  id                 String            @id @default(uuid()) @db.Uuid
  productionCycleId  String            @map("production_cycle_id") @db.Uuid
  productionCycle    ProductionCycle   @relation(fields: [productionCycleId], references: [id])
  recordDate         DateTime          @map("record_date")
  waterTemperatureC  Float?            @map("water_temperature_c")
  dissolvedOxygenMgL Float?            @map("dissolved_oxygen_mg_l")
  ph                 Float?
  ammoniaMgL         Float?            @map("ammonia_mg_l")
  nitriteMgL         Float?            @map("nitrite_mg_l")
  weatherSummary     String?           @map("weather_summary")
  feedingBehavior    String?           @map("feeding_behavior")
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([productionCycleId, recordDate])
  @@map("daily_records")
}

model FeedType {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String
  brand          String?
  pelletSizeMm   Float?                 @map("pellet_size_mm")
  proteinPercent Float?                 @map("protein_percent")
  lipidPercent   Float?                 @map("lipid_percent")
  notes          String?
  feedings       Feeding[]
  ingredients    FeedFormulaIngredient[]
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at")

  @@unique([name, brand])
  @@map("feed_types")
}

model FeedFormula {
  id              String                   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  recommendations String?
  targetStage     String?                  @map("target_stage")
  farmId          String?                  @map("farm_id") @db.Uuid
  ownerId         String?                  @map("owner_id") @db.Uuid
  farm            Farm?                    @relation(fields: [farmId], references: [id])
  owner           User?                    @relation(fields: [ownerId], references: [id])
  ingredients     FeedFormulaIngredient[]
  feedings        Feeding[]
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at")

  @@map("feed_formulas")
}

model FeedFormulaIngredient {
  id            String      @id @default(uuid()) @db.Uuid
  feedFormulaId String      @map("feed_formula_id") @db.Uuid
  feedTypeId    String      @map("feed_type_id") @db.Uuid
  inclusionPct  Float       @map("inclusion_pct")
  feedFormula   FeedFormula @relation(fields: [feedFormulaId], references: [id])
  feedType      FeedType    @relation(fields: [feedTypeId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")

  @@unique([feedFormulaId, feedTypeId])
  @@map("feed_formula_ingredients")
}

model Feeding {
  id                String          @id @default(uuid()) @db.Uuid
  productionCycleId String          @map("production_cycle_id") @db.Uuid
  productionCycle   ProductionCycle @relation(fields: [productionCycleId], references: [id])
  feedTypeId        String?         @map("feed_type_id") @db.Uuid
  feedFormulaId     String?         @map("feed_formula_id") @db.Uuid
  feedType          FeedType?       @relation(fields: [feedTypeId], references: [id])
  feedFormula       FeedFormula?    @relation(fields: [feedFormulaId], references: [id])
  feedingTime       DateTime        @map("feeding_time")
  quantityKg        Decimal         @map("quantity_kg") @db.Decimal(10, 2)
  moisturePercent   Float?          @map("moisture_percent")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([productionCycleId, feedingTime])
  @@map("feedings")
}

model GrowthMeasurement {
  id                  String            @id @default(uuid()) @db.Uuid
  productionCycleId   String            @map("production_cycle_id") @db.Uuid
  productionCycle     ProductionCycle   @relation(fields: [productionCycleId], references: [id])
  measurementDate     DateTime          @map("measurement_date")
  sampleSize          Int?              @map("sample_size")
  averageWeightKg     Decimal?          @map("average_weight_kg") @db.Decimal(8, 3)
  lengthCm            Float?            @map("length_cm")
  survivalRatePercent Float?            @map("survival_rate_percent")
  notes               String?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([productionCycleId, measurementDate])
  @@map("growth_measurements")
}

model Mortality {
  id                String          @id @default(uuid()) @db.Uuid
  productionCycleId String          @map("production_cycle_id") @db.Uuid
  productionCycle   ProductionCycle @relation(fields: [productionCycleId], references: [id])
  eventDate         DateTime        @map("event_date")
  count             Int
  cause             String?
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([productionCycleId, eventDate])
  @@map("mortalities")
}

model Treatment {
  id                String          @id @default(uuid()) @db.Uuid
  productionCycleId String          @map("production_cycle_id") @db.Uuid
  productionCycle   ProductionCycle @relation(fields: [productionCycleId], references: [id])
  treatmentDate     DateTime        @map("treatment_date")
  treatmentType     String          @map("treatment_type")
  productName       String?         @map("product_name")
  dosage            String?
  administeredBy    String?         @map("administered_by")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([productionCycleId, treatmentDate])
  @@map("treatments")
}

model ResearchSurvey {
  id                  String          @id @default(uuid()) @db.Uuid
  productionCycleId   String          @map("production_cycle_id") @db.Uuid
  productionCycle     ProductionCycle @relation(fields: [productionCycleId], references: [id])
  surveyDate          DateTime        @map("survey_date")
  surveyType          String          @map("survey_type")
  conductedBy         String?         @map("conducted_by")
  partnerOrganization String?         @map("partner_organization")
  dataPayload         Json?           @map("data_payload")
  notes               String?
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([productionCycleId, surveyDate])
  @@map("research_surveys")
}

model FarmerProfile {
  userId            String        @id @map("user_id") @db.Uuid
  user              User          @relation(fields: [userId], references: [id])
  firstName         String        @map("first_name")
  lastName          String        @map("last_name")
  phone             String        @map("phone")
  primaryFarmType   FarmType      @map("primary_farm_type")
  declaredPondCount Int?          @map("declared_pond_count")
  farmLatitude      Float?        @map("farm_latitude")
  farmLongitude     Float?        @map("farm_longitude")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at")

  @@map("farmer_profiles")
}

model ResearcherProfile {
  userId       String   @id @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @map("email")
  phone        String   @map("phone")
  organization String   @map("organization")
  department   String?  @map("department")
  jobTitle     String?  @map("job_title")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("researcher_profiles")
}

model FarmDataEntry {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  user               User      @relation(fields: [userId], references: [id])
  farmType           FarmType  @map("farm_type")
  recordedAt         DateTime  @map("recorded_at")
  fishAgeLabel       String    @map("fish_age_label")
  pondType           PondType? @map("pond_type")
  pondCount          Int?      @map("pond_count")
  fishCount          Int?      @map("fish_count")
  fishCountText      String?   @map("fish_count_text")
  weatherTemperatureC Float?   @map("weather_temperature_c")
  weatherRainMm      Float?    @map("weather_rain_mm")
  weatherHumidityPct Float?    @map("weather_humidity_pct")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([userId, recordedAt])
  @@map("farm_data_entries")
}


